# ========================================================
# Bizwoke Nova Environment Configuration
# ========================================================

# --- BACKEND (Render / Local Server) ---
PORT=5000

# Email Delivery Configuration (Optional - Nodemailer SMTP)
# Leave SMTP_USER and SMTP_PASS blank to log enquiries locally to server/data/leads.json without sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=contact@bizwoke.com

# Admin Security Token for Leads Review (Optional)
ADMIN_SECRET_KEY=bizwoke_enterprise_secure_token_2026

# --- FRONTEND (Vercel / Render Static Site) ---
# Optional: Set this only if frontend and backend are hosted on separate domains.
# E.g. On Vercel: VITE_API_URL=https://your-backend.onrender.com
# Leave blank for local development (uses Vite proxy) or single-service full-stack deployment.
VITE_API_URL=
